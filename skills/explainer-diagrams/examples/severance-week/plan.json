{
  "_note": "Plan that produced examples/severance-week/out/*.png. Replace the two path prefixes with absolute paths on your machine before running.",
  "url": "file:///ABS/PATH/TO/examples/severance-week/index.html",
  "viewport": {
    "width": 1300,
    "height": 1000,
    "deviceScaleFactor": 2
  },
  "steps": [
    {
      "type": "eval",
      "expr": "document.fonts.ready.then(() => true)",
      "label": "fonts-ready-promise-started"
    },
    {
      "type": "waitFor",
      "expr": "document.fonts.status === 'loaded'",
      "timeoutMs": 15000
    },
    {
      "type": "wait",
      "ms": 250
    },
    {
      "type": "eval",
      "expr": "document.fonts.check('1em \"Pixelify Sans\"')",
      "label": "pixelify-sans-loaded"
    },
    {
      "type": "eval",
      "expr": "(function(){var el=document.querySelector('#shot1'); el.scrollIntoView({block:'start'}); return el.getBoundingClientRect().height;})()",
      "label": "shot1-height"
    },
    {
      "type": "wait",
      "ms": 150
    },
    {
      "type": "shot",
      "selector": "#shot1",
      "path": "/ABS/PATH/TO/examples/severance-week/out/13-one-paragraph-five-days.png"
    },
    {
      "type": "eval",
      "expr": "(function(){var el=document.querySelector('#shot2'); el.scrollIntoView({block:'start'}); return el.getBoundingClientRect().height;})()",
      "label": "shot2-height"
    },
    {
      "type": "wait",
      "ms": 150
    },
